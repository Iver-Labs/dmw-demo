{
  "name": "dmw-demo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "cp -r public data models .next/standalone/ && cp -r .next/static .next/standalone/.next/ && cd .next/standalone && NODE_ENV=production node --env-file-if-exists=../../.env.local server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ingest": "node scripts/fetch-model.mjs && node --env-file-if-exists=.env.local --import tsx scripts/ingest.ts",
    "check:index": "node scripts/check-index.mjs",
    "eval": "node scripts/fetch-model.mjs && node --env-file-if-exists=.env.local --import tsx scripts/eval.ts",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run format:check",
    "model:fetch": "node scripts/fetch-model.mjs",
    "predev": "node scripts/fetch-model.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.1",
    "gray-matter": "4.0.3",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24 <27"
  }
}
